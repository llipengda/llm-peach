<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Peach.Pro.Test.OS.Linux</AssemblyName>
    <RootNamespace>Peach.Pro.Test.OS.Linux</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latestMajor</LangVersion>
    <IsTestProject>true</IsTestProject>
    <NativeFixtureExtension Condition="'$(OS)' == 'Windows_NT'">.exe</NativeFixtureExtension>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/.NETFramework*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\core\Core\Peach.Core.csproj" />
    <ProjectReference Include="..\..\..\..\core\Test\Peach.Core.Test.csproj" />
    <ProjectReference Include="..\..\..\Core\Peach.Pro.csproj" />
  </ItemGroup>

  <Target Name="BuildNativeTestFixtures" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <NativeFixturesOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)native-fixtures'))</NativeFixturesOutputDir>
    </PropertyGroup>
    <MSBuild Projects="..\..\Apps\NativeFixtures.proj"
             Targets="Build"
             Properties="Configuration=$(Configuration);NativeFixturesBuildDir=$(NativeFixturesOutputDir)/cmake;NativeFixturesOutputDir=$(NativeFixturesOutputDir)" />
    <ItemGroup>
      <NativeFixture Include="$(NativeFixturesOutputDir)/CrashTest$(NativeFixtureExtension)" />
      <NativeFixture Include="$(NativeFixturesOutputDir)/CrashableServer$(NativeFixtureExtension)" />
      <NativeFixture Include="$(NativeFixturesOutputDir)/CrashingFileConsumer$(NativeFixtureExtension)" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeFixture)"
          DestinationFolder="$(OutDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NLog" Version="4.7.15" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
