<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Peach.Build</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="core/Core/Peach.Core.csproj" />
    <ProjectReference Include="core/Minset/PeachMinset.csproj" />
    <ProjectReference Include="core/Test/Peach.Core.Test.csproj" />
    <ProjectReference Include="pro/Core/Peach.Pro.csproj" />
    <ProjectReference Include="pro/Peach/Peach.csproj" />
    <ProjectReference Include="pro/PeachAgent/PeachAgent.csproj" />
    <ProjectReference Include="pro/Worker/PeachWorker.csproj" />
    <ProjectReference Include="pro/Service/PeachService.csproj" />
    <ProjectReference Include="pro/PitTester/Peach.Pro.PitTester.csproj" />
    <ProjectReference Include="pro/PitTool/PitTool.csproj" />
    <ProjectReference Include="pro/OS/UnixTrampoline/PeachTrampoline.csproj" />
    <ProjectReference Include="pro/Test/Core/Peach.Pro.Test.csproj" />
    <ProjectReference Include="pro/Test/Apps/UseAfterFree/UseAfterFree.csproj" />
    <ProjectReference Include="pro/Test/Apps/CrashTestDummy/CrashTestDummy.csproj" />
    <ProjectReference Include="pro/Test/OS/Linux/Peach.Pro.Test.OS.Linux.csproj" />
    <ProjectReference Include="llm/Core/Peach.LLM.csproj" />
    <ProjectReference Include="llm/Validations/Common/Peach.LLM.Validations.Common.csproj" />
    <ProjectReference Include="llm/Validations/DataModel/Peach.LLM.Validations.DataModel.csproj" />
    <ProjectReference Include="llm/Validations/Mutator/Peach.LLM.Validations.Mutator.csproj" />
    <ProjectReference Include="llm/Validations/Fixer/Peach.LLM.Validations.Fixer.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="pro/Validator/PeachValidator.csproj" />
    <ProjectReference Include="pro/XmlGenerator/PeachXmlGenerator.csproj" />
  </ItemGroup>

  <!-- Keep one command-line test entry point for all test assemblies. -->
  <ItemGroup>
    <PeachTestProject Include="core/Test/Peach.Core.Test.csproj" />
    <PeachTestProject Include="pro/Test/Core/Peach.Pro.Test.csproj" />
    <PeachTestProject Include="pro/Test/OS/Linux/Peach.Pro.Test.OS.Linux.csproj" />
  </ItemGroup>

  <Target Name="RunPeachTests" AfterTargets="VSTest">
    <MSBuild Projects="@(PeachTestProject)"
             Targets="VSTest"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);VSTestNoBuild=$(VSTestNoBuild);VSTestVerbosity=$(VSTestVerbosity);VSTestTestAdapterPath=$(VSTestTestAdapterPath)" />
  </Target>

  <Target Name="ResolveBundledPin">
    <ItemGroup>
      <BundledPinConfig Include="$(MSBuildProjectDirectory)/3rdParty/pin/*/source/tools/Config/makefile.config" />
    </ItemGroup>
    <CreateProperty Value="$([System.IO.Path]::GetFullPath('%(BundledPinConfig.Identity)/../../../..'))" Condition="'@(BundledPinConfig)' != ''">
      <Output TaskParameter="Value" PropertyName="BundledPinRoot" />
    </CreateProperty>
  </Target>

  <Target Name="BuildPinTools" BeforeTargets="Build" DependsOnTargets="ResolveBundledPin">
    <MSBuild Condition="'$(BundledPinRoot)' != ''" Projects="core/BasicBlocks/BasicBlocks.proj"
             Targets="Build"
             Properties="PinRoot=$(BundledPinRoot);BasicBlocksOutputDir=$(BasicBlocksOutputDir)" />
    <MSBuild Condition="'$(BundledPinRoot)' != ''" Projects="core/CoveredEdge/CoveredEdge.proj"
             Targets="Build"
             Properties="PinRoot=$(BundledPinRoot);CoveredEdgeOutputDir=$(BasicBlocksOutputDir)" />
  </Target>
</Project>
