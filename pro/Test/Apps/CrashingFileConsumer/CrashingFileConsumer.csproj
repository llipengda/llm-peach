<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This fixture deliberately corrupts its stack when given a non-trivial file.
    Keep it native: the debugger tests verify GDB/exploitable's handling of a
    real native crash, rather than a managed exception or a simulated failure.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <NativeOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</NativeOutputDir>
    <NativeOutputPath>$(NativeOutputDir)/CrashingFileConsumer</NativeOutputPath>
  </PropertyGroup>

  <Target Name="Build" Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/CrashingFileConsumer.cpp" Outputs="$(NativeOutputPath)">
    <MakeDir Directories="$(NativeOutputDir)" />
    <Exec Command="g++ -g -O0 -fno-stack-protector -fno-omit-frame-pointer &quot;$(MSBuildProjectDirectory)/CrashingFileConsumer.cpp&quot; -o &quot;$(NativeOutputPath)&quot;" />
  </Target>
</Project>
