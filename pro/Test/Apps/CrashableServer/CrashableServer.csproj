<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Keep this native: debugger tests use its intentional stack overflow. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <NativeOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</NativeOutputDir>
    <NativeOutputPath>$(NativeOutputDir)/CrashableServer</NativeOutputPath>
  </PropertyGroup>

  <Target Name="Build" Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/CrashableServer.cpp" Outputs="$(NativeOutputPath)">
    <MakeDir Directories="$(NativeOutputDir)" />
    <Exec Command="g++ -g -O0 -fno-stack-protector -fno-omit-frame-pointer &quot;$(MSBuildProjectDirectory)/CrashableServer.cpp&quot; -o &quot;$(NativeOutputPath)&quot;" />
  </Target>
</Project>
