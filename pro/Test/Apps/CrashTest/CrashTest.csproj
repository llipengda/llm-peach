<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Keep the process/signal test fixture in its original native C form. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <NativeOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</NativeOutputDir>
    <NativeOutputPath>$(NativeOutputDir)/CrashTest</NativeOutputPath>
  </PropertyGroup>

  <Target Name="Build" Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/main.c" Outputs="$(NativeOutputPath)">
    <MakeDir Directories="$(NativeOutputDir)" />
    <Exec Command="gcc -g -O0 &quot;$(MSBuildProjectDirectory)/main.c&quot; -o &quot;$(NativeOutputPath)&quot;" />
  </Target>
</Project>
